<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>

<group name="samba, active_directory,">
  <rule id="100100" level="3">
    <match>Auth: [|NT_STATUS_|KDC_ERR_</match>
    <description>SambaAD: Active Response Event</description>
  </rule>

  <rule id="100101" level="8">
    <if_sid>100100</if_sid>
    <match>NT_STATUS_WRONG_PASSWORD|NT_STATUS_NO_SUCH_USER|KDC_ERR_C_PRINCIPAL_UNKNOWN</match>
    <description>Samba AD: Failed attemp to log in to the domain Active Directory</description>
  </rule>

  <rule id="100102" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <description>Samba AD: Multiple unsuccessful attemps to log in to the domain (Brute-force)</description>
  </rule>

</group>
